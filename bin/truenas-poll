#!/usr/bin/env bash
# Polls the one configured TrueNAS once: alerts, pools, system info, disks and
# their temperatures, the service and app lists, then rewrites state.json. Safe
# to run by hand; it is the whole read path of the plugin. `connection`
# describes the alert request, because alerts are the thing the bar exists to
# report, and the other sections fail independently.
set -uo pipefail

TN_PLUGIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=./truenas-lib.sh
. "$TN_PLUGIN_DIR/bin/truenas-lib.sh"

NOTIFY_BIN=${TRUENAS_NOTIFY_BIN:-omarchy-notification-send}
# The one target a toast's click action needs: the plugin's own menu, as
# manifest.json names it. The command is constant, so neither NAS text nor the
# configured base URL ever rides an exec argv.
PLUGIN_ID=io.github.h4ad.truenas
QUIET=0
FORCE_META=0
for arg in "$@"; do
  case $arg in
    --quiet)      QUIET=1 ;;
    --force-meta) FORCE_META=1 ;;
    *)            tn_warn "unknown option: $arg" ;;
  esac
done

config=$(tn_load_config)
config_error=$(jq -r '.configError // ""' <<<"$config")
poll_seconds=$(jq -r '.pollSeconds // 30' <<<"$config")
timeout=$(jq -r '.timeoutSeconds // 8' <<<"$config")
notify_json=$(jq -c '.notify // {}' <<<"$config")
instance=$(jq -c '.instances[0] // empty' <<<"$config")
STICKY_CRITICAL=$(jq -r 'if .stickyCritical == null then false else .stickyCritical end' <<<"$notify_json")
# /system/info changes on the scale of a TrueNAS update, not a poll, so it has
# its own slower cadence. 0 means every poll; the default is five minutes.
META_MAX_AGE=$(jq -r '.metaMaxAgeSeconds // 300' <<<"$notify_json")

# The output check's budget. One snapshot query per warm poll, and a longer
# timeout than the configured one because `?snapshot_name=` scans every dataset
# and takes about 20 s live. Both are constants, not config keys: the cap is the
# rate-limit guard and the timeout is what makes the measured route work.
OUTPUT_PROBE_CAP=1
OUTPUT_PROBE_TIMEOUT=30

# The keys the operator marked. tn_load_config has already dropped anything
# that is not `section:id`.
expect_output=$(jq -c '.expectOutput // []' <<<"$config")

# The Nerd Font glyphs the bar and the toasts share. Critical is the warning
# triangle, not a red circle, so a pool status and an alert read the same way.
GLYPH_CRITICAL=$'\uf071'
GLYPH_ALERT=$'\uf0f3'
GLYPH_OK=$'\uf00c'
GLYPH_OFFLINE=$'\uf1e6'

# Every toast goes out as an argv array, never a shell string, and every word in
# it is a constant or a number. /proc/<pid>/cmdline is world-readable on an
# ordinary procfs, so anything the NAS shaped (alert text, a pool, disk, service,
# app or task name, the NAS's own error words) and the configured base URL stay
# out of the call: the toast names the kind of event and the panel, which reads
# the state files, has the detail. The click runs the plugin's summoned menu,
# which needs none of that on a command line either.
notify() {
  local urgency=$1 glyph=$2 head=$3 body=${4:-}
  # The sender's contract: options first, then <headline> [description], and
  # --exec last with the command as separate argv words. A single exec word
  # holding a space is rejected outright, so the summon command is passed as
  # words and never built as one string.
  local args=(--app-name truenas -u "$urgency" -g "$glyph")
  if [[ -n $body ]]; then
    args+=("$head" "$body")
  else
    args+=("$head")
  fi
  args+=(--exec omarchy-shell -q shell summon "$PLUGIN_ID")
  "$NOTIFY_BIN" "${args[@]}" >/dev/null 2>&1 || true
}

# A critical-urgency toast never expires, which for a feed of alerts builds a
# wall that buries everything else. Critical maps to normal by default; staying
# on screen is opt-in through notify.stickyCritical.
urgency_for() {
  case $1 in
    critical|error)
      if [[ ${STICKY_CRITICAL:-false} == true ]]; then printf 'critical'
      else printf 'normal'; fi ;;
    warning) printf 'normal' ;;
    *)       printf 'low' ;;
  esac
}

glyph_for() {
  case $1 in
    critical|error) printf '%s' "$GLYPH_CRITICAL" ;;
    *)              printf '%s' "$GLYPH_ALERT" ;;
  esac
}

# The one sentence an outage toast is allowed to carry. The error class and the
# classified message can both be the NAS's own words (an `.error.code`, a
# message out of the body), so the toast quotes neither: the class is mapped
# here, and anything off this list reads as a generic failure.
brief_error() {
  case ${1:-} in
    timeout)         printf 'the request timed out' ;;
    unreachable)     printf 'the host did not answer' ;;
    not_json)        printf 'the answer was not JSON' ;;
    unauthenticated) printf 'the API key was rejected' ;;
    forbidden)       printf 'the key lacks permission for that route' ;;
    not_found)       printf 'the route was not found' ;;
    server_error)    printf 'the NAS reported a server error' ;;
    "")              printf '' ;;
    *)               printf 'the NAS reported an error' ;;
  esac
}

# The state words a toast may show are picked from closed vocabularies, not
# echoed: pool status, service state and job state come off the wire as text the
# NAS shaped, so a value outside the list the routes actually use reads as the
# generic word for its field instead. The panel, which reads the state files,
# still shows the real value.
pool_state() {
  case ${1:-} in
    ONLINE|DEGRADED|FAULTED|OFFLINE|UNAVAIL|REMOVED) printf '%s' "$1" ;;
    *) printf 'not ONLINE' ;;
  esac
}

service_state() {
  case ${1:-} in
    RUNNING|STOPPED) printf '%s' "$1" ;;
    "")              printf '' ;;
    *)               printf 'not RUNNING' ;;
  esac
}

job_state() {
  case ${1:-} in
    SUCCESS|FINISHED|FAILED|ERROR|ABORTED) printf '%s' "$1" ;;
    "")                                    printf 'unknown' ;;
    *)                                     printf 'did not finish' ;;
  esac
}

# Replication and cloud sync share one reduction. `kind` names both the payload
# section and the seen.json key; `use_warnings` includes a replication row's
# state.warnings as a failure. A job state outside the terminal set (RUNNING,
# WAITING, PENDING, blank) is non-decisive and carries the previous decisive
# state and failure forward untouched, so a transitional poll cannot clobber the
# signal a later failure is read against.
protection_notify() {
  local kind=$1 use_warnings=$2 noun=$3
  jq -c -n \
    --slurpfile payload "$WORK/payload.json" \
    --slurpfile seen "$WORK/seen.json" \
    --arg kind "$kind" \
    --argjson useWarnings "$use_warnings" \
    --arg now "$now" '
    ($seen[0]) as $seen
    | ($payload[0][$kind] // []) as $rows_in
    | ($seen[$kind] // {}) as $prev
    | (["SUCCESS","FINISHED","FAILED","ERROR","ABORTED"]) as $terminal
    | (["FAILED","ERROR","ABORTED"]) as $bad
    | [ $rows_in[]? as $row
        | ($row.id | if . == null then "" else tostring end) as $id
        | select($id != "")
        | ($row.job.state // "") as $js
        | (($row.state.warnings // []) | if type == "array" then . else [] end) as $warn
        | ($prev[$id] // null) as $old
        | (($terminal | index($js)) != null) as $terminalJob
        | (($warn | length) > 0) as $warned
        | { id: $id, name: ($row.name // ""), cur: $js,
            error: ($row.job.error // ""),
            prevState: ($old.state // ""),
            prevFailed: ($old.failed // false),
            existed: ($old != null),
            decisive: ($terminalJob or (($useWarnings == 1) and $warned)) }
        | . + { failure: ((.cur as $c | ($bad | index($c)) != null)
                          or (($useWarnings == 1) and $warned)) }
        | . + { wentBad: (.existed and (.prevFailed == false) and (.failure == true)),
                cameBack: (.existed and (.prevFailed == true) and (.failure == false)) }
      ] as $rows
    | {
        decisions: {
          failed: [ $rows[] | select(.decisive and .wentBad)
                    | { id: .id, name: .name, state: .cur, error: .error } ],
          recovered: [ $rows[] | select(.decisive and .cameBack)
                       | { id: .id, name: .name, state: .cur } ]
        },
        entries: (reduce $rows[] as $r ({};
          .[$r.id] = {
            state: (if $r.decisive then $r.cur else $r.prevState end),
            failed: (if $r.decisive then $r.failure else $r.prevFailed end),
            lastNotifiedAt: (
              if ($r.decisive and ($r.wentBad or $r.cameBack)) then $now
              else ($prev[$r.id].lastNotifiedAt // $now) end)
          }))
      }' >"$WORK/$kind-notify.json"

  # The task name and the job error are the NAS's own words, so only the kind
  # of event and the job state reach the toast; the panel has the rest.
  local state
  while IFS= read -r t; do
    [[ -n $t ]] || continue
    state=$(job_state "$(jq -r '.state' <<<"$t")")
    notify "$(urgency_for warning)" "$GLYPH_ALERT" "$noun failed" "job state $state"
  done < <(jq -c '.decisions.failed[]' "$WORK/$kind-notify.json")

  while IFS= read -r t; do
    [[ -n $t ]] || continue
    notify low "$GLYPH_OK" "$noun recovered"
  done < <(jq -c '.decisions.recovered[]' "$WORK/$kind-notify.json")

  local seen_next
  seen_next=$(jq -c --slurpfile seen "$WORK/seen.json" --arg kind "$kind" \
    '. as $d | ($seen[0]) + { ($kind): $d.entries }' "$WORK/$kind-notify.json")
  set_seen "$seen_next"
}

# A protection task that has stopped running without failing. The derivation
# in share/protection-overdue.jq owns the rule and the first-seen bookkeeping;
# this only turns a transition into a toast and advances that half of seen.json.
# The section's flag is already gated by the poll, so a failed section keeps its
# previous entries instead of reading as every task recovering.
overdue_notify() {
  local noun count body
  while IFS=$'\t' read -r noun count; do
    [[ -n $noun ]] || continue
    if ((count > 1)); then
      body="$count tasks, see the panel"
    else
      body="no run within its schedule"
    fi
    notify "$(urgency_for warning)" "$GLYPH_ALERT" "$noun is overdue" "$body"
  done < <(jq -r '
    def noun: if . == "replication" then "Replication"
              elif . == "cloudSync" then "Cloud sync"
              elif . == "snapshotTasks" then "Snapshot"
              else "Scrub" end;
    [ .decisions.overdue[].kind ] | group_by(.)[]
    | [ (.[0] | noun), length ] | @tsv' "$WORK/protection.json")

  while IFS=$'\t' read -r noun count; do
    [[ -n $noun ]] || continue
    if ((count > 1)); then
      body="$count tasks"
    else
      body=""
    fi
    notify low "$GLYPH_OK" "$noun ran again" "$body"
  done < <(jq -r '
    def noun: if . == "replication" then "Replication"
              elif . == "cloudSync" then "Cloud sync"
              elif . == "snapshotTasks" then "Snapshot"
              else "Scrub" end;
    [ .decisions.recovered[].kind ] | group_by(.)[]
    | [ (.[0] | noun), length ] | @tsv' "$WORK/protection.json")

  local seen_next
  seen_next=$(jq -c --slurpfile seen "$WORK/seen.json" \
    '. as $d | ($seen[0]) + { overdue: $d.protection }' "$WORK/protection.json")
  set_seen "$seen_next"
}

# The output check's toasts. The derivation already decided the transitions;
# this only groups them by kind, turns each group into one toast, and advances
# the output half of seen.json. Body text is chosen from `reason`, a closed
# vocabulary, so no dataset or snapshot name ever reaches argv.
output_notify() {
  local noun count reason body
  while IFS=$'\t' read -r noun count reason; do
    [[ -n $noun ]] || continue
    if ((count > 1)); then
      body="$count tasks, see the panel"
    elif [[ $reason == "empty" ]]; then
      body="the last run finished empty"
    elif [[ $reason == "missing" ]]; then
      body="the last snapshot is missing"
    else
      body="the last run produced no snapshot"
    fi
    notify "$(urgency_for error)" "$(glyph_for error)" "$noun produced no data" "$body"
  done < <(jq -r '
    def noun: if . == "replication" then "Replication"
              elif . == "snapshotTasks" then "Snapshot"
              else empty end;
    [ .decisions.noData[] | select((.kind | noun) != null) ]
    | group_by(.kind)[]
    | [ (.[0].kind | noun), length, ([ .[].reason ] | unique | join(",")) ] | @tsv
  ' "$WORK/protection-output.json")

  while IFS=$'\t' read -r noun count; do
    [[ -n $noun ]] || continue
    if ((count > 1)); then
      body="$count tasks"
    else
      body=""
    fi
    notify low "$GLYPH_OK" "$noun has data again" "$body"
  done < <(jq -r '
    def noun: if . == "replication" then "Replication"
              elif . == "snapshotTasks" then "Snapshot"
              else empty end;
    [ .decisions.dataBack[] | select((.kind | noun) != null) ]
    | group_by(.kind)[]
    | [ (.[0].kind | noun), length ] | @tsv
  ' "$WORK/protection-output.json")

  local seen_next
  seen_next=$(jq -c --slurpfile seen "$WORK/seen.json" \
    '. as $d | ($seen[0]) + { output: $d.output }' "$WORK/protection-output.json")
  set_seen "$seen_next"
}

# The output check's query pass. It runs after the overdue pass has annotated
# payload.json and only on a warm poll (a cold poll already spent the request
# budget on the meta fetch). It writes $WORK/output-probe.json keyed by
# `<section>:<id>`; one entry per due task, even when several tasks share one
# query. A failed query is an entry with ok:false, never a missing entry: the
# derivation keeps the previous answer and advances lastProbeAt so the task
# moves to the back of the queue instead of holding a slot every poll.
snapshot_probe() {
  local q filter value encoded n
  printf '{}\n' >"$WORK/output-probe.json"
  rm -f "$WORK"/probe-part.*.json

  if ! jq -c -n \
    --slurpfile payload "$WORK/payload.json" \
    --slurpfile seen "$WORK/seen.json" \
    --argjson expect "$expect_output" \
    --argjson cap "$OUTPUT_PROBE_CAP" '
    def up: if type == "string" then ascii_upcase else "" end;
    def state_ok($row):
      (if (($row.job.state // "") | type) == "string"
          and ($row.job.state // "") != ""
       then ($row.job.state | up)
       else (($row.state.state // "") | up) end) as $s
      | ($s == "SUCCESS" or $s == "FINISHED")
        and ((($row.state.warnings // [])
              | if type == "array" then length else 0 end) == 0);
    def local_rep:
      ((.direction // "" | up) == "PULL") or ((.transport // "" | up) == "LOCAL");
    def cand($row; $key; $filter; $value; $dataset; $snapshot):
      { taskKey: $key, filter: $filter, queryValue: $value,
        dataset: $dataset, snapshot: $snapshot,
        lastRunAt: $row.lastRunAt,
        lastProbeAt: ($seen[0].output[$key].lastProbeAt // "") };
    ($payload[0]) as $p
    | ($seen[0].output // {}) as $out
    | ([ $p.snapshotTasks[]?
         | . as $row
         | ($row.id | if . == null then "" else tostring end) as $id
         | select($id != "")
         | ("snapshotTasks:" + $id) as $key
         | select($expect | index($key))
         | select($row.scheduled == true and $row.overdue == false)
         | select(state_ok($row))
         | select(($row.lastRunAt // null) != null)
         | select(($out[$key].lastRunAt // null) != $row.lastRunAt)
         | ($row.state.lastSnapshot // null) as $ls
         | select(($ls | type) == "string")
         | ($ls | split("@")) as $parts
         | select(($parts | length) == 2)
         | select(($parts[0] | length) > 0 and ($parts[1] | length) > 0)
         | if $row.recursive then
             cand($row; $key; "snapshot_name"; $parts[1]; $row.dataset; $ls)
           else
             cand($row; $key; "name"; $ls; $row.dataset; $ls)
           end ]) as $snaps
    | ([ $p.replication[]?
         | . as $row
         | ($row.id | if . == null then "" else tostring end) as $id
         | select($id != "")
         | ("replication:" + $id) as $key
         | select($expect | index($key))
         | select($row.scheduled == true and $row.overdue == false)
         | select(local_rep)
         | select(state_ok($row))
         | select(($row.lastRunAt // null) != null)
         | select(($row.targetDataset // "") != "")
         | select(($out[$key].lastRunAt // null) != $row.lastRunAt)
         | ($row.state.lastSnapshot // null) as $ls
         | select(($ls | type) == "string")
         | ($ls | split("@")) as $parts
         | select(($parts | length) == 2)
         | select(($parts[1] | length) > 0)
         | ($row.targetDataset + "@" + $parts[1]) as $snapshot
         | if $row.recursive then
             cand($row; $key; "snapshot_name"; $parts[1]; $row.targetDataset; $snapshot)
           else
             cand($row; $key; "name"; $snapshot; $row.targetDataset; $snapshot)
           end ]) as $reps
    | ($snaps + $reps)
    | sort_by([ .lastProbeAt, .lastRunAt, (.filter + ":" + .queryValue) ])
    | . as $all
    | { candidates: $all,
        queue: (reduce $all[] as $t ({keys: [], out: []};
                 ($t.filter + ":" + $t.queryValue) as $q
                 | if (.keys | index($q)) == null
                   then .keys += [$q]
                      | .out += [{ filter: $t.filter, queryValue: $t.queryValue }]
                   else . end)
               | .out[:$cap]) }
  ' >"$WORK/probe-candidates.json"; then
    return 1
  fi

  n=0
  while IFS= read -r q; do
    [[ -n $q ]] || continue
    printf '%s\n' "$q" >"$WORK/probe-query.json"
    filter=$(jq -r '.filter' <<<"$q")
    value=$(jq -r '.queryValue' <<<"$q")
    # The value is NAS text (a dataset or snapshot name), so it is percent
    # encoded from stdin and never appears on a child's argv. The query itself
    # reaches jq as a file for the same reason.
    encoded=$(printf '%s' "$value" | jq -sRr @uri)
    fetch snapshotRows "/api/v2.0/pool/snapshot?${filter}=${encoded}" \
      "$WORK/snapshot-rows.json" GET "" "$OUTPUT_PROBE_TIMEOUT"
    n=$((n + 1))
    if [[ -n $S_ERR ]]; then
      jq -c --arg now "$now" --slurpfile query "$WORK/probe-query.json" '
        [ .candidates[]
          | select(.filter == $query[0].filter
                   and .queryValue == $query[0].queryValue)
          | { (.taskKey): { lastRunAt, attemptedAt: $now, ok: false,
                            found: false, written: null, snapshot: null } } ]
        | add // {}' "$WORK/probe-candidates.json" >"$WORK/probe-part.$n.json" \
        || return 1
    else
      jq -c --arg now "$now" --slurpfile query "$WORK/probe-query.json" \
         --slurpfile rows "$WORK/snapshot-rows.json" '
        def zfs_units: {"K":1024,"M":1048576,"G":1073741824,
                        "T":1099511627776,"P":1125899906842624,
                        "E":1152921504606846976};
        def zfs_bytes:
          if type != "string" then null
          else (ascii_upcase | sub("B$"; "")) as $s
            | if ($s | test("^[0-9]+$")) then ($s | tonumber)
              elif ($s | test("^[0-9]+(\\.[0-9]+)?[KMGTPE]$"))
              then ((($s[0:-1] | tonumber) * zfs_units[$s[-1:]]) | round)
              else null end
          end;
        [ .candidates[]
          | select(.filter == $query[0].filter
                   and .queryValue == $query[0].queryValue)
          | . as $t
          | (if $t.filter == "name" then
               [ $rows[0][]? | select((.name // "") == $t.snapshot) ]
             else
               [ $rows[0][]? | select((.snapshot_name // "") == $t.queryValue)
                              | select((.dataset // "") == $t.dataset
                                       or ((.dataset // "")
                                           | startswith($t.dataset + "/"))) ]
             end) as $found
          | { ($t.taskKey): {
                lastRunAt: $t.lastRunAt,
                attemptedAt: $now,
                ok: true,
                found: (($found | length) > 0),
                written: (if ($found | length) == 0 then null
                          else ([ $found[] | (.properties.written.value | zfs_bytes) ] as $w
                                | if ($w | length) > 0 and all($w[]; . != null)
                                  then ($w | add)
                                  else null end)
                          end),
                snapshot: $t.snapshot } } ]
        | add // {}' "$WORK/probe-candidates.json" >"$WORK/probe-part.$n.json" \
        || return 1
    fi
  done < <(jq -c '.queue[]?' "$WORK/probe-candidates.json")

  ((n > 0)) || return 0
  jq -s 'add // {}' "$WORK"/probe-part.*.json >"$WORK/output-probe.json" || return 1
  return 0
}

# Appends one capacity sample to the sparkline history: the fullest pool's used
# percent, or null when no pool reports one. A null is a gap in the chart, not a
# fabricated 0 percent. The list is capped at HISTORY_MAX, oldest dropped first,
# and `at` carries the matching timestamps. Called only after a successful poll,
# so a failed poll leaves the file alone rather than recording a gap it did not
# observe.
HISTORY_MAX=60
append_capacity_history() {
  local pct next
  pct=$(jq -r '([.pools[]? | .usedPct | select(type == "number")] | if length == 0 then null else max end)' \
    "$WORK/state.json")
  next=$(tn_read_json "$TN_HISTORY_FILE" '{"capacityPct":[],"at":[]}' \
    | jq -c --argjson pct "$pct" --arg now "$now" --argjson cap "$HISTORY_MAX" '
        { capacityPct: ((.capacityPct // []) + [$pct]
                        | if length > $cap then .[length - $cap:] else . end),
          at:          ((.at // []) + [$now]
                        | if length > $cap then .[length - $cap:] else . end) }')
  tn_write_json "$TN_HISTORY_FILE" <<<"$next"
}

now=$(tn_now)
previous=$(tn_read_json "$TN_STATE_FILE" '{}')
seen=$(tn_read_json "$TN_SEEN_FILE" '{}')
meta=$(tn_read_json "$TN_META_FILE" '{}')

# A cache entry is reusable only when all thirteen sections are present and the
# system fetch time is fresh. A missing, empty, or unparsable meta.json reads
# as `{}` here and is always stale, so nothing is silently reported as null.
# An older meta.json without the disk, service, app, protection or share keys is
# stale once, refetches once, and self-heals. --force-meta short-circuits the
# age check on top of a normal poll.
meta_is_stale() {
  ((FORCE_META)) && return 0
  jq -e '(.system.data != null) and (.disks.rows != null) and (.diskTemps.map != null) and (.services.rows != null) and (.apps.rows != null) and (.replication.rows != null) and (.cloudSync.rows != null) and (.snapshotTasks.rows != null) and (.scrubs.rows != null) and (.smb.rows != null) and (.nfs.rows != null) and (.iscsi.rows != null) and (.network.rows != null)' \
    <<<"$meta" >/dev/null 2>&1 || return 0
  local fetched then_epoch now_epoch
  fetched=$(jq -r '.system.fetchedAt // ""' <<<"$meta")
  [[ -n $fetched ]] || return 0
  then_epoch=$(date -u -d "$fetched" +%s 2>/dev/null) || return 0
  now_epoch=$(date -u +%s)
  (( now_epoch - then_epoch >= META_MAX_AGE ))
}

prev_failures=$(jq -r '.connection.consecutiveFailures // 0' <<<"$previous")
prev_last_ok=$(jq -r '.connection.lastOkAt // ""' <<<"$previous")
prev_outage=$(jq -r '.connection.outageNotified // false' <<<"$previous")

WORK=$(mktemp -d "${TMPDIR:-/tmp}/truenas-poll.XXXXXX")
# TN_BODY is its own mktemp under TMPDIR rather than one inside $WORK, so
# removing the directory is not enough: a poll killed mid-request would leave
# the last response body behind. Read with a default because the trap is
# installed before the first request has set it and `set -u` is on.
TN_BODY=""
trap 'rm -rf "$WORK"; rm -f "${TN_BODY:-}"' EXIT

# seen.json and meta.json are what jq slurps. Both carry NAS text (alert text
# and names in the history, hostnames, dataset paths and share names in the
# cache), so they travel as files, never as argv words: an argv word is visible
# to every local user through /proc/<pid>/cmdline on an ordinary procfs.
printf '%s\n' "$seen" >"$WORK/seen.json"
printf '%s\n' "$meta" >"$WORK/meta.json"

# Every write to `seen` goes through here, so the file jq slurps and the
# variable the rest of the poll reads cannot drift apart.
set_seen() {
  [[ -n ${1:-} ]] || return 0
  seen=$1
  printf '%s\n' "$seen" >"$WORK/seen.json"
}

warnings='[]'

# The shape every failure path emits for the sections, so a failed request
# contributes no rows and no fabricated zeroes.
default_payload() {
  printf '%s\n' '{"system":null,"counts":{"critical":0,"error":0,"warning":0,"notice":0,"info":0,"total":0,"dismissed":0},"alerts":[],"pools":[],"disks":[],"services":[],"apps":[],"replication":[],"cloudSync":[],"snapshotTasks":[],"scrubs":[],"shares":{"smb":[],"nfs":[],"iscsi":[]},"network":[]}' >"$WORK/payload.json"
}

# The section name and the error class are short codes, but the class can be the
# NAS's own `.error.code`, and the message is whatever the body said, so all
# three reach jq through files: --rawfile reads each back as a string and no
# document rides an argv element.
warn_section() {
  printf '%s' "$1" >"$WORK/warning-section.txt"
  printf '%s' "$2" >"$WORK/warning-error.txt"
  printf '%s' "$3" >"$WORK/warning-message.txt"
  warnings=$(jq -c --rawfile s "$WORK/warning-section.txt" \
                    --rawfile e "$WORK/warning-error.txt" \
                    --rawfile m "$WORK/warning-message.txt" \
    '. + [{ section: $s, error: $e, message: $m }]' <<<"$warnings")
}

classify_message() {
  local err=$1 rc=$2 msg=""
  case $err in
    timeout|unreachable) msg=$(tn_curl_rc_message "$rc") ;;
    not_json)            msg="the response was not JSON" ;;
    unauthenticated)     msg="the API key was rejected" ;;
    forbidden)           msg="the API key lacks permission for that route" ;;
    *)                   msg=$(tn_error_message) ;;
  esac
  [[ -n $msg ]] || msg=$err
  printf '%s' "$msg"
}

# A 200 is only success when the body carries the shape its route promises. A
# wrong-shaped body (an empty object, a bare value) would normalize into
# fabricated empty strings and zeroes that read exactly like a real answer, so
# it is a section failure. Runs only once the request itself succeeded.
expect_shape() {
  local body=$1 shape=$2
  [[ -z $S_ERR ]] || return 0
  jq -e "$shape" "$body" >/dev/null 2>&1 || S_ERR=not_json
}

# One endpoint into its own body file. On any failure the file is null and the
# section is named in `warnings`; on success the validated body is copied,
# because the request helper reuses the same TN_BODY path on every call.
# `method` and `payload` let the two POST-only disk routes share this one
# failure path; GET stays the default so existing calls are untouched.
fetch() {
  local section=$1 path=$2 out=$3 method=${4:-GET} payload=${5:-} request_timeout=${6:-$timeout} rc shape
  if [[ $method == GET ]]; then
    tn_http_get "$base" "$path" "$key" "$request_timeout"
  else
    tn_http_request "$method" "$base" "$path" "$key" "$request_timeout" "$payload"
  fi
  rc=$TN_CURL_RC
  S_ERR=$(tn_classify)
  # A healthy alert/list, pool and disk/details is always a JSON array. The
  # service and app lists are arrays of objects, so a bare null entry is a
  # failed section rather than a nameless card. system/info is a non-empty
  # object, and so is disk/temperatures (an empty map is a NAS that answered
  # with no readings, not a failed route).
  case $section in
    service|app)     shape='type == "array" and all(.[]; type == "object")' ;;
    replication|cloudSync|snapshotTasks|scrubs) \
                     shape='type == "array" and all(.[]; type == "object")' ;;
    smb|nfs|iscsi|network) \
                     shape='type == "array" and all(.[]; type == "object")' ;;
    alert|pool|disk) shape='type == "array"' ;;
    # The one probe route added after the meta sections. An unknown section
    # leaves `shape` empty, and `jq -e ""` is a compile error, which would mark
    # every snapshot answer not_json and silently disable the output check.
    snapshotRows)    shape='type == "array"' ;;
    system)          shape='type == "object" and (length > 0)' ;;
    diskTemp)        shape='type == "object"' ;;
  esac
  expect_shape "$TN_BODY" "$shape"
  if [[ -n $S_ERR ]]; then
    S_MSG=$(classify_message "$S_ERR" "$rc")
    printf 'null\n' >"$out"
    warn_section "$section" "$S_ERR" "$S_MSG"
  else
    S_MSG=""
    cp "$TN_BODY" "$out"
  fi
  rm -f "$TN_BODY"
}

error=""
message=""
code=0
latency=0
attempted=0
normalize_ok=1
protection_ready=0
output_ready=0
meta_reused=0
system_fetched=0
system_ok=0
disks_fetched=0
disks_ok=0
disk_temps_fetched=0
disk_temps_ok=0
service_fetched=0
service_ok=0
app_fetched=0
app_ok=0
replication_fetched=0
replication_ok=0
cloudsync_fetched=0
cloudsync_ok=0
snapshot_fetched=0
snapshot_ok=0
scrub_fetched=0
scrub_ok=0
smb_fetched=0
smb_ok=0
nfs_fetched=0
nfs_ok=0
iscsi_fetched=0
iscsi_ok=0
network_fetched=0
network_ok=0
default_payload
# The output pass reads this even on a poll that never probed, so the empty
# document is part of the same initial state as the payload.
printf '{}\n' >"$WORK/output-probe.json"

if [[ -n $config_error || -z $instance ]]; then
  # No key to resolve and nothing to ask: the panel still needs a document.
  error=${config_error:-unconfigured}
else
  id=$(jq -r '.id' <<<"$instance")
  base=$(jq -r '.baseUrl' <<<"$instance")
  key_file=$(jq -r '.apiKeyFile // ""' <<<"$instance")
  key_cmd=$(jq -r '.apiKeyCommand // ""' <<<"$instance")

  resolved=$(tn_resolve_key "$id" "$key_file" "$key_cmd")
  if [[ $resolved != ok:* ]]; then
    error=${resolved#err:}
  else
    key=${resolved#ok:}
    attempted=1

    fetch alert "/api/v2.0/alert/list" "$WORK/alerts.json"
    # The alerts request is the connection: its code, latency and reason.
    error=$S_ERR
    message=$S_MSG
    code=$TN_CODE
    latency=$TN_TIME_MS

    fetch pool   "/api/v2.0/pool"        "$WORK/pools.json"
    # A failed pool call is named in `warnings`, which `pools_ok` reads below,
    # so it cannot read as every pool having gone or come back.

    # /system/info, disk/details, disk/temperatures, service and app are
    # slow-moving and ride the meta cache. On reuse the cached raw bodies are
    # copied back into $WORK, so exactly one normalizer still owns the shape on
    # both paths. A forced or lapsed fetch goes through `fetch`, which on
    # failure names the section and writes null.
    if meta_is_stale; then
      fetch system "/api/v2.0/system/info" "$WORK/system.json"
      system_fetched=1
      [[ -z $S_ERR ]] && system_ok=1

      # disk/details answers a plain array for {"type":"USED"}. The
      # temperatures request is built from the names it returned, so a failed
      # details fetch has nothing to ask about and skips it entirely.
      printf '%s\n' '{"type":"USED"}' >"$WORK/disk-details-request.json"
      fetch disk "/api/v2.0/disk/details" "$WORK/disks.json" \
        POST "$WORK/disk-details-request.json"
      disks_fetched=1
      [[ -z $S_ERR ]] && disks_ok=1
      # normalize.jq always receives this slurpfile, so a skipped temperatures
      # request leaves an explicit null rather than a missing file.
      printf 'null\n' >"$WORK/disk-temps.json"
      if [[ -z $S_ERR ]]; then
        jq -c '{name: [.[].name], include_thresholds: true}' "$WORK/disks.json" \
          >"$WORK/disk-temps-request.json"
        fetch diskTemp "/api/v2.0/disk/temperatures" "$WORK/disk-temps.json" \
          POST "$WORK/disk-temps-request.json"
        disk_temps_fetched=1
        [[ -z $S_ERR ]] && disk_temps_ok=1
      fi

      # The service and app lists are read whole and filtered client-side;
      # there is no query route. Each fails independently of the disks.
      fetch service "/api/v2.0/service" "$WORK/services.json"
      service_fetched=1
      [[ -z $S_ERR ]] && service_ok=1

      fetch app "/api/v2.0/app" "$WORK/apps.json"
      app_fetched=1
      [[ -z $S_ERR ]] && app_ok=1

      # Shares and interfaces are read whole and filtered client-side. The three
      # share types do not share a route or a field vocabulary: SMB and NFS live
      # under /sharing, iSCSI under /iscsi, and the interface collection at
      # /interface. Each fails independently of the others.
      fetch smb "/api/v2.0/sharing/smb" "$WORK/smb.json"
      smb_fetched=1
      [[ -z $S_ERR ]] && smb_ok=1

      fetch nfs "/api/v2.0/sharing/nfs" "$WORK/nfs.json"
      nfs_fetched=1
      [[ -z $S_ERR ]] && nfs_ok=1

      fetch iscsi "/api/v2.0/iscsi/target" "$WORK/iscsi.json"
      iscsi_fetched=1
      [[ -z $S_ERR ]] && iscsi_ok=1

      fetch network "/api/v2.0/interface" "$WORK/network.json"
      network_fetched=1
      [[ -z $S_ERR ]] && network_ok=1

      # Protection tasks are read whole and filtered client-side; each fails
      # independently of the disks. /cloudsync is normally empty. The scrub
      # route carries no run state, only the task schedule.
      fetch replication "/api/v2.0/replication" "$WORK/replication.json"
      replication_fetched=1
      [[ -z $S_ERR ]] && replication_ok=1

      fetch cloudSync "/api/v2.0/cloudsync" "$WORK/cloudsync.json"
      cloudsync_fetched=1
      [[ -z $S_ERR ]] && cloudsync_ok=1

      fetch snapshotTasks "/api/v2.0/pool/snapshottask" "$WORK/snapshot-tasks.json"
      snapshot_fetched=1
      [[ -z $S_ERR ]] && snapshot_ok=1

      fetch scrubs "/api/v2.0/pool/scrub" "$WORK/scrubs.json"
      scrub_fetched=1
      [[ -z $S_ERR ]] && scrub_ok=1
    else
      meta_reused=1
      jq -c -n --slurpfile meta "$WORK/meta.json" '
        ($meta[0].system.data // null) as $s
        | { hostname:       ($s.hostname // ""),
            version:        ($s.version // ""),
            uptime_seconds: ($s.uptimeSeconds // null),
            cores:          ($s.cores // null),
            physmem:        ($s.physmem // null),
            loadavg:        ($s.loadavg // null) }' >"$WORK/system.json"
      jq -c '.disks.rows // []' <<<"$meta" >"$WORK/disks.json"
      jq -c '.diskTemps.map // {}' <<<"$meta" >"$WORK/disk-temps.json"
      jq -c '.services.rows // []' <<<"$meta" >"$WORK/services.json"
      jq -c '.apps.rows // []' <<<"$meta" >"$WORK/apps.json"
      jq -c '.replication.rows // []' <<<"$meta" >"$WORK/replication.json"
      jq -c '.cloudSync.rows // []' <<<"$meta" >"$WORK/cloudsync.json"
      jq -c '.snapshotTasks.rows // []' <<<"$meta" >"$WORK/snapshot-tasks.json"
      jq -c '.scrubs.rows // []' <<<"$meta" >"$WORK/scrubs.json"
      jq -c '.smb.rows // []' <<<"$meta" >"$WORK/smb.json"
      jq -c '.nfs.rows // []' <<<"$meta" >"$WORK/nfs.json"
      jq -c '.iscsi.rows // []' <<<"$meta" >"$WORK/iscsi.json"
      jq -c '.network.rows // []' <<<"$meta" >"$WORK/network.json"
    fi

    if ! jq -n -f "$TN_PLUGIN_DIR/share/normalize.jq" \
           --slurpfile system "$WORK/system.json" \
           --slurpfile alerts "$WORK/alerts.json" \
           --slurpfile pools  "$WORK/pools.json" \
           --slurpfile disks  "$WORK/disks.json" \
           --slurpfile diskTemps "$WORK/disk-temps.json" \
           --slurpfile services "$WORK/services.json" \
           --slurpfile apps "$WORK/apps.json" \
           --slurpfile replication "$WORK/replication.json" \
           --slurpfile cloudSync "$WORK/cloudsync.json" \
           --slurpfile snapshotTasks "$WORK/snapshot-tasks.json" \
           --slurpfile scrubs "$WORK/scrubs.json" \
           --slurpfile smb "$WORK/smb.json" \
           --slurpfile nfs "$WORK/nfs.json" \
           --slurpfile iscsi "$WORK/iscsi.json" \
           --slurpfile network "$WORK/network.json" \
           --arg now "$now" >"$WORK/payload.json" 2>/dev/null; then
      normalize_ok=0
      default_payload
      warn_section normalize not_json "could not normalize the response"
    fi
  fi
fi

if [[ -z $error ]]; then
  failures=0
  last_ok=$now
else
  failures=$((prev_failures + 1))
  last_ok=$prev_last_ok
fi

# --- Notifications and seen.json --------------------------------------------
# A failed poll leaves seen.json untouched, so a network blip cannot replay
# every alert as new on recovery. The outage counter rides in state.json rather
# than seen.json: it advances on failure, and its recovery ping is sent once.
outage_notified=$prev_outage
if [[ -n $error ]]; then
  threshold=$(jq -r '.connectionFailuresBeforeToast // 3' <<<"$notify_json")
  if (( attempted )) && [[ $prev_outage != true ]] && (( failures >= threshold )); then
    notify low "$GLYPH_OFFLINE" "TrueNAS unreachable" "$(brief_error "$error")"
    outage_notified=true
  fi
else
  # A successful poll after an outage we toasted is the one recovery ping.
  if [[ $prev_outage == true ]]; then
    notify low "$GLYPH_OK" "TrueNAS reachable again"
  fi
  outage_notified=false

  # A section's half of seen.json only advances when its own request produced a
  # payload worth recording: a warning naming the section, or a normalization
  # that fell back to the empty default, means there is no answer to trust.
  # Writing then would erase alerts that are still firing and read the erasure
  # as a resolution, and would wipe a pool's last known state the same way.
  alert_warned=$(jq -r '[.[] | select(.section == "alert")] | length' <<<"$warnings")
  pool_warned=$(jq -r '[.[] | select(.section == "pool")] | length' <<<"$warnings")
  disk_warned=$(jq -r '[.[] | select(.section == "disk")] | length' <<<"$warnings")
  disk_temp_warned=$(jq -r '[.[] | select(.section == "diskTemp")] | length' <<<"$warnings")
  service_warned=$(jq -r '[.[] | select(.section == "service")] | length' <<<"$warnings")
  app_warned=$(jq -r '[.[] | select(.section == "app")] | length' <<<"$warnings")
  alerts_ok=$((normalize_ok == 1 && alert_warned == 0))
  pools_ok=$((normalize_ok == 1 && pool_warned == 0))
  # `disks_ok` above is the fetch flag the meta gate reads; this is the
  # notification gate. Either disk section failing means there is no disk
  # answer worth recording: writing then would mark a hot disk unknown and
  # replay it as hot on the next good poll.
  disks_notify_ok=$((normalize_ok == 1 && disk_warned == 0 && disk_temp_warned == 0))
  # A service or app answer that failed, or that normalization could not read,
  # carries no current rows worth recording. Without its gate that half of
  # seen.json is not written: a blip must not replay every service as stopped
  # on the poll after it.
  services_notify_ok=$((normalize_ok == 1 && service_warned == 0))
  apps_notify_ok=$((normalize_ok == 1 && app_warned == 0))
  # A replication or cloud sync answer that failed carries no current rows
  # worth recording. Without its gate that half of seen.json is not written.
  replication_warned=$(jq -r '[.[] | select(.section == "replication")] | length' <<<"$warnings")
  cloudsync_warned=$(jq -r '[.[] | select(.section == "cloudSync")] | length' <<<"$warnings")
  replication_notify_ok=$((normalize_ok == 1 && replication_warned == 0))
  cloudsync_notify_ok=$((normalize_ok == 1 && cloudsync_warned == 0))
  snapshot_warned=$(jq -r '[.[] | select(.section == "snapshotTasks")] | length' <<<"$warnings")
  scrub_warned=$(jq -r '[.[] | select(.section == "scrubs")] | length' <<<"$warnings")
  snapshots_notify_ok=$((normalize_ok == 1 && snapshot_warned == 0))
  # A scrub's last run lives on the pool's scan, so a failed pool section leaves
  # the scrub age unknown. The task's own answer alone is not enough.
  scrubs_notify_ok=$((normalize_ok == 1 && scrub_warned == 0 && pool_warned == 0))

  # The overdue flag is derived once here so the bar, the views and the toast
  # read the same value. The grace is six hours: a daily task alarms about 30
  # hours after its last finish, not the moment its cron slot passes.
  protection_ready=0
  if jq -n -f "$TN_PLUGIN_DIR/share/protection-overdue.jq" \
         --slurpfile payload "$WORK/payload.json" \
         --slurpfile seen "$WORK/seen.json" \
         --arg now "$now" --argjson graceSeconds 21600 \
         --argjson replicationOk "$replication_notify_ok" \
         --argjson cloudSyncOk "$cloudsync_notify_ok" \
         --argjson snapshotTasksOk "$snapshots_notify_ok" \
         --argjson scrubsOk "$scrubs_notify_ok" \
         >"$WORK/protection.json" 2>/dev/null; then
    protection_ready=1
    jq -c '.payload' "$WORK/protection.json" >"$WORK/payload-overdue.json" \
      && mv "$WORK/payload-overdue.json" "$WORK/payload.json"
  fi

  levels=$(jq -c '.levels // ["critical","error","warning"]' <<<"$notify_json")
  renotify=$(jq -r '.renotifyMinutes // 0' <<<"$notify_json")
  batch=$(jq -r '.batchThreshold // 3' <<<"$notify_json")
  want_resolved=$(jq -r 'if .resolved == null then true else .resolved end' <<<"$notify_json")
  # A cleared alert is only true when the alert list itself is trustworthy.
  ((alerts_ok)) || want_resolved=false

  jq -c -n \
    --slurpfile payload "$WORK/payload.json" \
    --slurpfile seen "$WORK/seen.json" \
    --argjson levels "$levels" \
    --argjson renotify "$renotify" \
    --arg now "$now" '
    ($seen[0]) as $seen
    | ($payload[0]) as $p
    | ($seen.alerts // {}) as $prev
    | ($p.alerts // []) as $all
    # A dismissed alert is out of the notification path completely: no first
    # toast, no renotify, and no seen entry, so a later sighting is new again.
    # The resolved list is computed against the whole array, dismissed rows
    # included, so dismissing one never reads as it clearing.
    | ($all | map(select(.dismissed != true))
            | map(select(.level as $l | $levels | index($l)))) as $eligible
    | ($now | fromdateiso8601) as $t
    | {
        firing: [ $eligible[] | select($prev[.uuid] == null) ],
        renotify: [ $eligible[]
                    | select($prev[.uuid] != null)
                    | select($renotify > 0)
                    | select((($prev[.uuid].lastNotifiedAt // "1970-01-01T00:00:00Z")
                              | fromdateiso8601) + ($renotify * 60) <= $t) ],
        resolved: [ $prev | to_entries[] as $e
                    | select( ($all | map(.uuid) | index($e.key)) == null )
                    | $e.value + { uuid: $e.key } ]
      }' >"$WORK/decisions.json"

  firing_count=$(jq '.firing | length' "$WORK/decisions.json")
  if (( firing_count > batch )); then
    crit=$(jq '[ .firing[] | select(.level == "critical" or .level == "error") ] | length' \
      "$WORK/decisions.json")
    notify normal "$GLYPH_CRITICAL" \
      "$firing_count new alerts" "$crit critical or error"
  else
    # The alert text and the node name are the NAS's words; the toast carries
    # the level only and the panel has the rest.
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      sev=$(jq -r '.level' <<<"$a")
      notify "$(urgency_for "$sev")" "$(glyph_for "$sev")" "New $sev alert"
    done < <(jq -c '.firing[]' "$WORK/decisions.json")
  fi

  while IFS= read -r a; do
    [[ -n $a ]] || continue
    sev=$(jq -r '.level' <<<"$a")
    notify "$(urgency_for "$sev")" "$(glyph_for "$sev")" "Still firing: $sev alert"
  done < <(jq -c '.renotify[]' "$WORK/decisions.json")

  if [[ $want_resolved == true ]]; then
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      notify low "$GLYPH_OK" "Alert resolved"
    done < <(jq -c '.resolved[]' "$WORK/decisions.json")
  fi

  if ((alerts_ok)); then
    seen_next=$(jq -c -n \
      --slurpfile seen "$WORK/seen.json" \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile decisions "$WORK/decisions.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($decisions[0]) as $d
      | ($seen.alerts // {}) as $prev
      | (reduce ($p.alerts[]? | select(.dismissed != true)) as $a ({};
          .[$a.uuid] = {
            level: $a.level,
            name: $a.text,
            firstSeenAt: ($prev[$a.uuid].firstSeenAt // $now),
            lastNotifiedAt: (
              if (($d.firing | map(.uuid) | index($a.uuid)) != null)
                 or (($d.renotify | map(.uuid) | index($a.uuid)) != null)
              then $now
              else ($prev[$a.uuid].lastNotifiedAt // $now) end)
          })) as $next
      | $seen + { alerts: $next }')
    set_seen "$seen_next"
  fi

  if ((pools_ok)); then
    jq -c -n \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile seen "$WORK/seen.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($seen.pools // {}) as $prev
      | {
          worsened: [ ($p.pools // [])[] as $pool
                      | ($prev[$pool.name] // null) as $old
                      | select($pool.status != "ONLINE")
                      | select(($old == null) or ($old.status == "ONLINE"))
                      | { name: $pool.name, status: $pool.status } ],
          recovered: [ ($p.pools // [])[] as $pool
                       | ($prev[$pool.name] // null) as $old
                       | select($pool.status == "ONLINE")
                       | select($old != null and $old.status != "ONLINE")
                       | { name: $pool.name, status: $pool.status } ]
        }' >"$WORK/pool-decisions.json"

    # The pool name is the NAS's word, so the toast carries only the status,
    # and only when it is one the pool routes actually report.
    while IFS= read -r p; do
      [[ -n $p ]] || continue
      notify normal "$GLYPH_CRITICAL" "A pool is $(pool_state "$(jq -r '.status' <<<"$p")")"
    done < <(jq -c '.worsened[]' "$WORK/pool-decisions.json")

    while IFS= read -r p; do
      [[ -n $p ]] || continue
      notify low "$GLYPH_OK" "A pool is ONLINE again"
    done < <(jq -c '.recovered[]' "$WORK/pool-decisions.json")

    seen_pools=$(jq -c -n \
      --slurpfile seen "$WORK/seen.json" \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile decisions "$WORK/pool-decisions.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($decisions[0]) as $d
      | ($seen.pools // {}) as $prev
      | (reduce ($p.pools[]?) as $pool ({};
          .[$pool.name] = {
            status: $pool.status,
            lastNotifiedAt: (
              if (($d.worsened | map(.name) | index($pool.name)) != null)
                 or (($d.recovered | map(.name) | index($pool.name)) != null)
              then $now
              else ($prev[$pool.name].lastNotifiedAt // $now) end)
          })) as $next
      | $seen + { pools: $next }')
    set_seen "$seen_pools"
  fi

  if ((disks_notify_ok)); then
    jq -c -n \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile seen "$WORK/seen.json" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($seen.disks // {}) as $prev
      | {
          hot: [ ($p.disks // [])[] as $disk
                 | ($prev[$disk.name] // null) as $old
                 | select($disk.tempState == "warning"
                          or $disk.tempState == "critical")
                 | select($old == null
                          or ($old.state != "warning" and $old.state != "critical"))
                 | { name: $disk.name, state: $disk.tempState,
                     tempC: $disk.tempC, tempCriticalC: $disk.tempCriticalC } ],
          cooled: [ ($p.disks // [])[] as $disk
                    | ($prev[$disk.name] // null) as $old
                    | select($disk.tempState == "ok")
                    | select($old != null
                             and ($old.state == "warning" or $old.state == "critical"))
                    | { name: $disk.name, state: $disk.tempState,
                        tempC: $disk.tempC } ]
        }' >"$WORK/disk-decisions.json"

    # The disk name is the NAS's, so the toast names the event and keeps only
    # the readings: both are numbers the panel shows too.
    while IFS= read -r d; do
      [[ -n $d ]] || continue
      sev=$(jq -r '.state' <<<"$d")
      # The warning band starts ten degrees below critical, the rule
      # share/normalize.jq decides tempState with; the row carries only the
      # critical threshold, so the band start is derived here.
      notify "$(urgency_for "$sev")" "$(glyph_for "$sev")" "A disk is hot" \
        "$(jq -r 'if .state == "critical"
                  then "\(.tempC | round) °C, critical at \(.tempCriticalC | round) °C"
                  else "\(.tempC | round) °C, warning at \(.tempCriticalC - 10 | round) °C"
                  end' <<<"$d")"
    done < <(jq -c '.hot[]' "$WORK/disk-decisions.json")

    while IFS= read -r d; do
      [[ -n $d ]] || continue
      notify low "$GLYPH_OK" "A disk cooled" \
        "$(jq -r '"\(.tempC | round) °C"' <<<"$d")"
    done < <(jq -c '.cooled[]' "$WORK/disk-decisions.json")

    seen_disks=$(jq -c -n \
      --slurpfile seen "$WORK/seen.json" \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile decisions "$WORK/disk-decisions.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($decisions[0]) as $d
      | ($seen.disks // {}) as $prev
      | (reduce ($p.disks[]?) as $disk ({};
          .[$disk.name] = {
            state: $disk.tempState,
            tempC: $disk.tempC,
            lastNotifiedAt: (
              if (($d.hot | map(.name) | index($disk.name)) != null)
                 or (($d.cooled | map(.name) | index($disk.name)) != null)
              then $now
              else ($prev[$disk.name].lastNotifiedAt // $now) end)
          })) as $next
      | $seen + { disks: $next }')
    set_seen "$seen_disks"
  fi

  if ((services_notify_ok)); then
    # A decisive service state is any non-empty state. seen stores the last
    # decisive state and a stable `down` boolean, not the raw observation: a
    # blank or transitional poll carries both forward untouched, so it cannot
    # erase the signal a later crash or recovery is read against. Reduce over
    # the current rows only, so a service dropped from the list leaves no seen
    # entry behind.
    jq -c -n \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile seen "$WORK/seen.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($seen.services // {}) as $prev
      | [ $p.services[]? as $svc
          | ($prev[$svc.service] // null) as $old
          | { name: $svc.service,
              cur: $svc.state,
              prevState: ($old.state // ""),
              prevDown: ($old.down // false),
              decided: ($svc.state != ""),
              seen: ($old != null) }
          | . + { down: (if .decided then (.cur != "RUNNING") else .prevDown end) }
          | . + { stopped:   (.seen and (.prevDown == false) and (.down == true)),
                  recovered: (.seen and (.prevDown == true) and (.down == false)) } ] as $rows
      | {
          decisions: {
            stopped: [ $rows[] | select(.stopped)
                       | { name: .name, state: .cur, prev: .prevState } ],
            recovered: [ $rows[] | select(.recovered)
                         | { name: .name, state: .cur } ]
          },
          services: (reduce $rows[] as $r ({};
            .[$r.name] = {
              state: (if $r.decided then $r.cur else $r.prevState end),
              down: $r.down,
              lastNotifiedAt: (
                if ($r.stopped or $r.recovered) then $now
                else ($prev[$r.name].lastNotifiedAt // $now) end)
            }))
        }' >"$WORK/service-notify.json"

    # The service name is the NAS's; the state and the transition it was read
    # against are whitelisted words, because the wire field is text the NAS
    # shaped.
    while IFS= read -r s; do
      [[ -n $s ]] || continue
      svc_state=$(service_state "$(jq -r '.state' <<<"$s")")
      svc_prev=$(service_state "$(jq -r '.prev // ""' <<<"$s")")
      if [[ -n $svc_prev ]]; then
        svc_body="state changed from $svc_prev to $svc_state"
      else
        svc_body="state changed to $svc_state"
      fi
      notify "$(urgency_for warning)" "$GLYPH_ALERT" \
        "A service is $svc_state" "$svc_body"
    done < <(jq -c '.decisions.stopped[]' "$WORK/service-notify.json")

    while IFS= read -r s; do
      [[ -n $s ]] || continue
      notify low "$GLYPH_OK" "A service is running again"
    done < <(jq -c '.decisions.recovered[]' "$WORK/service-notify.json")

    seen_services=$(jq -c --slurpfile seen "$WORK/seen.json" \
      '. as $d | ($seen[0]) + { services: $d.services }' "$WORK/service-notify.json")
    set_seen "$seen_services"
  fi

  if ((apps_notify_ok)); then
    # The decisive and down sets are closed literals. RUNNING, STOPPED, CRASHED,
    # FAILED and EXITED are decisive; DEPLOYING, STARTING, STOPPING, blank and
    # anything else off the list are non-decisive and carry the last decisive
    # state forward. Reduce over the current rows only.
    jq -c -n \
      --slurpfile payload "$WORK/payload.json" \
      --slurpfile seen "$WORK/seen.json" \
      --arg now "$now" '
      ($seen[0]) as $seen
      | ($payload[0]) as $p
      | ($seen.apps // {}) as $prev
      | (["RUNNING","STOPPED","CRASHED","FAILED","EXITED"]) as $decisive
      | (["STOPPED","CRASHED","FAILED","EXITED"]) as $down
      | [ $p.apps[]? as $app
          | ($prev[$app.name] // null) as $old
          | { name: $app.name,
              cur: $app.state,
              prevState: ($old.state // ""),
              prevDown: ($old.down // false),
              decided: (($decisive | index($app.state)) != null),
              seen: ($old != null) }
          | .cur as $c
          | . + { down: (if .decided then (($down | index($c)) != null)
                         else .prevDown end) }
          | . + { stopped:   (.seen and (.prevDown == false) and (.down == true)),
                  recovered: (.seen and (.prevDown == true) and (.down == false)) } ] as $rows
      | {
          decisions: {
            stopped: [ $rows[] | select(.stopped)
                       | { name: .name, state: .cur, prev: .prevState } ],
            recovered: [ $rows[] | select(.recovered)
                         | { name: .name, state: .cur } ]
          },
          apps: (reduce $rows[] as $r ({};
            .[$r.name] = {
              state: (if $r.decided then $r.cur else $r.prevState end),
              down: $r.down,
              lastNotifiedAt: (
                if ($r.stopped or $r.recovered) then $now
                else ($prev[$r.name].lastNotifiedAt // $now) end)
            }))
        }' >"$WORK/app-notify.json"

    # The app name is the NAS's; the state and the transition are closed
    # vocabularies and stay.
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      app_state=$(jq -r '.state' <<<"$a")
      app_prev=$(jq -r '.prev // ""' <<<"$a")
      if [[ -n $app_prev ]]; then
        app_body="state changed from $app_prev to $app_state"
      else
        app_body="state changed to $app_state"
      fi
      notify "$(urgency_for warning)" "$GLYPH_ALERT" \
        "An app is $app_state" "$app_body"
    done < <(jq -c '.decisions.stopped[]' "$WORK/app-notify.json")

    while IFS= read -r a; do
      [[ -n $a ]] || continue
      notify low "$GLYPH_OK" "An app is running again"
    done < <(jq -c '.decisions.recovered[]' "$WORK/app-notify.json")

    seen_apps=$(jq -c --slurpfile seen "$WORK/seen.json" \
      '. as $d | ($seen[0]) + { apps: $d.apps }' "$WORK/app-notify.json")
    set_seen "$seen_apps"
  fi

  if ((replication_notify_ok)); then
    protection_notify replication 1 "Replication"
  fi

  if ((cloudsync_notify_ok)); then
    protection_notify cloudSync 0 "Cloud sync"
  fi

  if ((protection_ready)); then
    overdue_notify
  fi

  # The output probe is a warm-poll pass: a cold poll already spent fifteen
  # requests on the meta fetch, and the cached row still carries the run on the
  # next warm poll. A probe failure is named in `warnings` as `snapshotRows` by
  # fetch, or as `output` when the pass itself cannot build its inputs.
  if ((protection_ready && normalize_ok && meta_reused)); then
    if ! snapshot_probe; then
      warn_section output not_json "could not run the output check"
    fi
  fi

  # One jq pass owns noData, so the bar, the card and the toast cannot disagree.
  # It still runs on a cold poll (with an empty probe file): a due task becomes
  # unknown and keeps its previous badge instead of reading as healthy.
  if ((protection_ready && normalize_ok)); then
    if jq -n -f "$TN_PLUGIN_DIR/share/protection-output.jq" \
         --slurpfile payload "$WORK/payload.json" \
         --slurpfile seen "$WORK/seen.json" \
         --slurpfile probe "$WORK/output-probe.json" \
         --argjson expect "$expect_output" \
         --arg now "$now" \
         --argjson replicationOk "$replication_notify_ok" \
         --argjson cloudSyncOk "$cloudsync_notify_ok" \
         --argjson snapshotTasksOk "$snapshots_notify_ok" \
         --argjson scrubsOk "$scrubs_notify_ok" \
         --argjson normalizeOk "$normalize_ok" \
         >"$WORK/protection-output.json" 2>/dev/null; then
      output_ready=1
      jq -c '.payload' "$WORK/protection-output.json" >"$WORK/payload-output.json" \
        && mv "$WORK/payload-output.json" "$WORK/payload.json"
    else
      output_ready=0
      warn_section output not_json "could not derive the output check"
    fi
  fi

  if ((output_ready)); then
    output_notify
  fi
  # The probe is the last reader of the key. Drop it here rather than before
  # the probe, or every snapshot query would send an empty credential.
  unset key resolved
fi

# Only a successful poll writes seen.json: a failed one must not advance (or
# create) it, which is what lets a recovery replay nothing.
if [[ -z $error ]]; then
  printf '%s\n' "$seen" | tn_write_json "$TN_SEEN_FILE"
fi

# The meta cache advances only when this poll refetched all thirteen slow
# sections and normalized them. A reuse writes nothing, and any failed section
# leaves the previous meta.json byte-for-byte intact, so state reports the
# failure while the last good copy survives for the next poll.
if ((system_fetched && system_ok && disks_fetched && disks_ok \
     && disk_temps_fetched && disk_temps_ok && normalize_ok \
     && service_fetched && service_ok && app_fetched && app_ok \
     && replication_fetched && replication_ok \
     && cloudsync_fetched && cloudsync_ok \
     && snapshot_fetched && snapshot_ok \
     && scrub_fetched && scrub_ok \
     && smb_fetched && smb_ok && nfs_fetched && nfs_ok \
     && iscsi_fetched && iscsi_ok && network_fetched && network_ok)); then
  meta=$(jq -c -n --slurpfile meta "$WORK/meta.json" --arg now "$now" \
    --slurpfile payload "$WORK/payload.json" \
    --slurpfile disks "$WORK/disks.json" \
    --slurpfile diskTemps "$WORK/disk-temps.json" \
    --slurpfile services "$WORK/services.json" \
    --slurpfile apps "$WORK/apps.json" \
    --slurpfile replication "$WORK/replication.json" \
    --slurpfile cloudSync "$WORK/cloudsync.json" \
    --slurpfile snapshotTasks "$WORK/snapshot-tasks.json" \
    --slurpfile scrubs "$WORK/scrubs.json" \
    --slurpfile smb "$WORK/smb.json" \
    --slurpfile nfs "$WORK/nfs.json" \
    --slurpfile iscsi "$WORK/iscsi.json" \
    --slurpfile network "$WORK/network.json" '
    def cron: {
      minute: (.minute // null), hour: (.hour // null), dom: (.dom // null),
      month: (.month // null), dow: (.dow // null),
      begin: (.begin // null), end: (.end // null)
    };
    ($meta[0]) as $meta
    | ($payload[0].system) as $s
    | if $s == null then $meta
      else $meta + {
        system: { fetchedAt: $now, data: $s },
        # Only the fields the plugin consumes are cached, under their wire
        # names. disk/details also carries serials, identifiers and lunids;
        # those never leave the NAS.
        disks: {
          fetchedAt: $now,
          rows: [ $disks[0][]? | { name:          (.name // null),
                                   model:         (.model // null),
                                   type:          (.type // null),
                                   size:          (.size // null),
                                   imported_zpool: (.imported_zpool // null),
                                   bus:           (.bus // null) } ]
        },
        diskTemps: { fetchedAt: $now, map: $diskTemps[0] },
        # The service list drops pids; the app list drops notes, image ids and
        # the workload details, keeping only the count. Whitelisting the fields
        # here, rather than deleting known-bad ones, is what keeps a new wire
        # field from leaking to disk by accident. The service id goes through
        # `+ 0`, the same canonicalization the num def applies in normalize.jq,
        # so a wire 4.0 caches as 4 rather than as raw text.
        services: {
          fetchedAt: $now,
          rows: [ $services[0][]? | { id:      ((.id? // null) | (tonumber? // null) | if . == null then null else . + 0 end),
                                      service: (.service // ""),
                                      state:   (.state // ""),
                                      enable:  (.enable == true) } ]
        },
        apps: {
          fetchedAt: $now,
          rows: [ $apps[0][]? | ((.metadata? // {}) | if type == "object" then . else {} end) as $m
                 | { name:               (.name // ""),
                     id:                 (.id // null),
                     state:              (.state // ""),
                     custom_app:         (.custom_app == true),
                     upgrade_available:  (.upgrade_available == true),
                     migrated:           (.migrated == true),
                     human_version:      (.human_version // null),
                     version:            (.version // null),
                     metadata: { title:       ($m.title // null),
                                 app_version: ($m.app_version // null),
                                 train:       ($m.train // null),
                                 home:        ($m.home // null),
                                 icon:        ($m.icon // null) },
                     portals:           (.portals // {}),
                     active_workloads: { containers: (.active_workloads.containers? // null) } } ]
        },
        # Protection rows, reduced to the fields the normalizer reads under
        # their wire names. The nested state and job are whitelisted so
        # logs_excerpt, exception, ssh_credentials and encryption_key never
        # reach disk; the schedule keeps the seven cron keys.
        replication: {
          fetchedAt: $now,
          rows: [ $replication[0][]? | {
                    id:              (.id? // null),
                    name:            (.name // null),
                    direction:       (.direction // null),
                    transport:       (.transport // null),
                    source_datasets: (.source_datasets // null),
                    target_dataset:  (.target_dataset // null),
                    recursive:       (.recursive == true),
                    enabled:         (.enabled == true),
                    auto:            (.auto == true),
                    retention_policy: (.retention_policy // null),
                    lifetime_value:  (.lifetime_value // null),
                    lifetime_unit:   (.lifetime_unit // null),
                    retries:         (.retries // null),
                    schedule: (if (.schedule? | type) == "object"
                               then (.schedule | cron) else null end),
                    # A replication task can run off the schedule of the
                    # periodic snapshot tasks it names instead of its own
                    # schedule, which is null in that case. Only the schedules
                    # are kept; the embedded snapshot state is dropped.
                    periodic_snapshot_tasks: [
                      (.periodic_snapshot_tasks? // [])[]?
                      | { enabled: (.enabled == true),
                          schedule: (if (.schedule | type) == "object"
                                     then (.schedule | cron) else null end) }
                    ],
                    state: (if (.state? | type) == "object" then
                              { state:        (.state.state // null),
                                datetime:     (.state.datetime // null),
                                warnings:     ((.state.warnings? // []) | if type == "array" then . else [] end),
                                last_snapshot: (.state.last_snapshot // null) }
                            else null end),
                    job: (if (.job? | type) == "object" then
                            { state:         (.job.state // null),
                              time_finished: (.job.time_finished // null),
                              error:         (.job.error // null) }
                          else null end) } ]
        },
        cloudSync: {
          fetchedAt: $now,
          rows: [ $cloudSync[0][]? | {
                    id:            (.id? // null),
                    description:   (.description // null),
                    path:          (.path // null),
                    enabled:       (.enabled == true),
                    direction:     (.direction // null),
                    transfer_mode: (.transfer_mode // null),
                    schedule: (if (.schedule? | type) == "object" then
                                 { minute: (.schedule.minute // null),
                                   hour:   (.schedule.hour // null),
                                   dom:    (.schedule.dom // null),
                                   month:  (.schedule.month // null),
                                   dow:    (.schedule.dow // null),
                                   begin:  (.schedule.begin // null),
                                   end:    (.schedule.end // null) }
                               else null end),
                    job: (if (.job? | type) == "object" then
                            { state:         (.job.state // null),
                              time_finished: (.job.time_finished // null),
                              error:         (.job.error // null) }
                          else null end) } ]
        },
        snapshotTasks: {
          fetchedAt: $now,
          rows: [ $snapshotTasks[0][]? | {
                    id:             (.id? // null),
                    dataset:        (.dataset // null),
                    recursive:      (.recursive == true),
                    enabled:        (.enabled == true),
                    lifetime_value: (.lifetime_value // null),
                    lifetime_unit:  (.lifetime_unit // null),
                    naming_schema:  (.naming_schema // null),
                    allow_empty:    (.allow_empty == true),
                    schedule: (if (.schedule? | type) == "object" then
                                 { minute: (.schedule.minute // null),
                                   hour:   (.schedule.hour // null),
                                   dom:    (.schedule.dom // null),
                                   month:  (.schedule.month // null),
                                   dow:    (.schedule.dow // null),
                                   begin:  (.schedule.begin // null),
                                   end:    (.schedule.end // null) }
                               else null end),
                    state: (if (.state? | type) == "object" then
                              { state:         (.state.state // null),
                                datetime:      (.state.datetime // null),
                                last_snapshot: (.state.last_snapshot // null) }
                            else null end) } ]
        },
        scrubs: {
          fetchedAt: $now,
          rows: [ $scrubs[0][]? | {
                    id:          (.id? // null),
                    pool:        (.pool // null),
                    pool_name:   (.pool_name // null),
                    threshold:   (.threshold // null),
                    description: (.description // null),
                    enabled:     (.enabled == true),
                    schedule: (if (.schedule? | type) == "object" then
                                 { minute: (.schedule.minute // null),
                                   hour:   (.schedule.hour // null),
                                   dom:    (.schedule.dom // null),
                                   month:  (.schedule.month // null),
                                   dow:    (.schedule.dow // null),
                                   begin:  (.schedule.begin // null),
                                   end:    (.schedule.end // null) }
                               else null end) } ]
        },
        # Shares. Each row keeps only the fields its normalizer reads, under the
        # wire names. The SMB audit and options blobs, the NFS hosts, networks
        # and security lists, and the iSCSI groups and iscsi_parameters never
        # reach disk.
        smb: {
          fetchedAt: $now,
          rows: [ $smb[0][]? | {
                    id:       (.id? // null),
                    name:     (.name // null),
                    path:     (.path // null),
                    enabled:  (.enabled == true),
                    locked:   (.locked == true),
                    readonly: (.readonly == true),
                    purpose:  (.purpose // null),
                    comment:  (.comment // null) } ]
        },
        nfs: {
          fetchedAt: $now,
          rows: [ $nfs[0][]? | {
                    id:      (.id? // null),
                    path:    (.path // null),
                    enabled: (.enabled == true),
                    locked:  (.locked == true),
                    ro:      (.ro == true),
                    comment: (.comment // null) } ]
        },
        iscsi: {
          fetchedAt: $now,
          rows: [ $iscsi[0][]? | {
                    id:    (.id? // null),
                    name:  (.name // null),
                    alias: (.alias // null),
                    mode:  (.mode // null) } ]
        },
        # The network row keeps the nested state object reduced to the four keys
        # the normalizer reads, because iface_norm reads state.link_state on both
        # the fetch and the reuse path. Every MAC (link_address,
        # permanent_link_address, hardware_link_address) and every other state
        # key is dropped before the write; the aliases keep only type, address
        # and netmask, so broadcast goes too.
        network: {
          fetchedAt: $now,
          rows: [ $network[0][]? | {
                    name: (.name // null),
                    type: (.type // null),
                    state: (if (.state? | type) == "object" then
                              { link_state:           (.state.link_state // null),
                                media_type:           (.state.media_type // null),
                                active_media_subtype: (.state.active_media_subtype // null),
                                aliases: [ (.state.aliases? // [])[]?
                                           | if type == "object" then
                                               { type:    (.type // null),
                                                 address: (.address // null),
                                                 netmask: (.netmask // null) }
                                             else empty end ] }
                            else null end) } ]
        }
      } end')
  printf '%s\n' "$meta" >"$WORK/meta.json"
  printf '%s\n' "$meta" | tn_write_json "$TN_META_FILE"
fi

# The connection error and its message can both be the NAS's own words, and the
# warnings list is built from them, so all three reach jq through files: an
# argv word is visible to every local user through /proc/<pid>/cmdline.
printf '%s' "$error" >"$WORK/error.txt"
printf '%s' "$message" >"$WORK/message.txt"
printf '%s\n' "$warnings" >"$WORK/warnings.json"

jq -n \
  --slurpfile payload "$WORK/payload.json" \
  --slurpfile warnings "$WORK/warnings.json" \
  --arg now "$now" \
  --argjson poll "${poll_seconds:-30}" \
  --rawfile error "$WORK/error.txt" --rawfile message "$WORK/message.txt" \
  --argjson code "${code:-0}" --argjson latency "${latency:-0}" \
  --argjson failures "$failures" --arg lastOk "$last_ok" \
  --argjson outageNotified "$outage_notified" \
  --arg dialect "$(tn_dialect)" '
  ($payload[0]) as $p
  | ($warnings[0] // []) as $w
  | {
      schema: 1,
      updatedAt: $now,
      pollSeconds: $poll,
      connection: {
        ok: ($error == ""),
        httpStatus: $code,
        latencyMs: $latency,
        error: (if $error == "" then null else $error end),
        message: (if $message == "" then null else $message end),
        consecutiveFailures: $failures,
        lastOkAt: (if $lastOk == "" then null else $lastOk end),
        outageNotified: $outageNotified,
        version: (if (($p.system // {}).version // "") == "" then null else $p.system.version end),
        dialect: $dialect
      },
      system: $p.system,
      counts: $p.counts,
      alerts: $p.alerts,
      pools: $p.pools,
      disks: $p.disks,
      services: $p.services,
      apps: $p.apps,
      replication: $p.replication,
      cloudSync: $p.cloudSync,
      snapshotTasks: $p.snapshotTasks,
      scrubs: $p.scrubs,
      shares: $p.shares,
      network: $p.network,
      warnings: $w
    }' >"$WORK/state.json"

tn_write_json "$TN_STATE_FILE" <"$WORK/state.json"
# The sparkline's history is fed only by a poll that reached the NAS. A failed
# connection records nothing at all, so the chart does not grow a gap it cannot
# tell from an unknown capacity.
[[ -z $error ]] && append_capacity_history
((QUIET)) || cat "$TN_STATE_FILE"
