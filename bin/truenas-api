#!/usr/bin/env bash
# The one write path the panel has: alert dismiss/restore, the service and app
# control verbs, and the protection run verbs. Every verb answers with a single
# JSON object, so Panel.qml has one shape to parse whether the write landed or
# not: {"ok":true} on a JSON 2xx (the NAS answers `true` for a service, a job id
# for an app or a protection run, `null` for a snapshot task), and
# {error, message} otherwise. A 2xx whose body is not JSON at all is a failure
# (`not_json`), which is how a route that does not exist is told from a landed
# write.
#
# The key is resolved exactly the way the poller resolves it and handed to curl
# as a config file on stdin, never in argv. The name or uuid is written into the
# request body by jq, never interpolated into a shell string, so a value that
# came off the wire can only ever be one JSON string and never a second field.
# An id that goes into a path is validated numeric first.
set -uo pipefail

TN_PLUGIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=./truenas-lib.sh
. "$TN_PLUGIN_DIR/bin/truenas-lib.sh"

usage() {
  cat <<'TXT'
truenas-api <verb> <name|uuid>

  dismiss <uuid>          dismiss one alert
  restore <uuid>          restore a dismissed alert
  service-start <name>    start a service
  service-stop <name>     stop a service
  service-restart <name>  restart a service
  app-start <name>        start an app
  app-stop <name>         stop an app
  app-redeploy <name>     redeploy an app
  replication-run <id>    run a replication task now
  cloudsync-sync <id>     run a cloud sync task now
  snapshot-run <id>       run a periodic snapshot task now
  scrub-start <pool>      start a scrub for a pool

Answers with one JSON object: {"ok":true} on success, {error, message} otherwise.
TXT
}

fail() {
  jq -n --arg error "$1" --arg message "${2:-}" '{ error: $error, message: $message }'
  exit 1
}

tn_have jq || { tn_warn "jq is required"; exit 1; }

# Unknown verb first, so the usage text is the only thing on the way out and the
# exit status (2) is a different class from a failed write (1). Each arm names
# its route, how the body is built and the word for the positional argument, so
# the request below and this guard read the same table. `body=field` writes one
# key; `body=int` writes the bare integer the replication run route expects;
# `body=scrub` writes the name and action pair; `body=none` sends no body, with
# the id already in the path.
verb=${1:-}
target=${2:-}
id_in_path=0
case $verb in
  dismiss)         path=/api/v2.0/alert/dismiss;   body=field; body_key=uuid;     what="an alert uuid" ;;
  restore)         path=/api/v2.0/alert/restore;   body=field; body_key=uuid;     what="an alert uuid" ;;
  service-start)   path=/api/v2.0/service/start;   body=field; body_key=service;  what="a service name" ;;
  service-stop)    path=/api/v2.0/service/stop;    body=field; body_key=service;  what="a service name" ;;
  service-restart) path=/api/v2.0/service/restart; body=field; body_key=service;  what="a service name" ;;
  app-start)       path=/api/v2.0/app/start;       body=field; body_key=app_name; what="an app name" ;;
  app-stop)        path=/api/v2.0/app/stop;        body=field; body_key=app_name; what="an app name" ;;
  app-redeploy)    path=/api/v2.0/app/redeploy;    body=field; body_key=app_name; what="an app name" ;;
  replication-run) path=/api/v2.0/replication/run;              body=int;   what="a replication id" ;;
  cloudsync-sync)  path=/api/v2.0/cloudsync/id/{id}/sync;       body=none;  id_in_path=1; what="a cloud sync id" ;;
  snapshot-run)    path=/api/v2.0/pool/snapshottask/id/{id}/run; body=none; id_in_path=1; what="a snapshot task id" ;;
  scrub-start)     path=/api/v2.0/pool/scrub/scrub;             body=scrub; what="a pool name" ;;
  *) usage >&2; exit 2 ;;
esac

# Exactly one positional. A second one is a usage error rather than a silent
# ignore, because a caller that passed the wrong tuple needs to hear about it.
(( $# > 2 )) && { tn_warn "truenas-api takes one argument, got $(( $# - 1 ))"; usage >&2; exit 2; }
[[ -n $target ]] || { tn_warn "a $verb needs $what"; usage >&2; exit 2; }

config=$(tn_load_config)
config_error=$(jq -r '.configError // ""' <<<"$config")
[[ -z $config_error ]] || fail "$config_error"

instance=$(jq -c '.instances[0] // empty' <<<"$config")
[[ -n $instance ]] || fail "unconfigured"

id=$(jq -r '.id' <<<"$instance")
base=$(jq -r '.baseUrl' <<<"$instance")
timeout=$(jq -r '.timeoutSeconds // 8' <<<"$config")

resolved=$(tn_resolve_key "$id" \
  "$(jq -r '.apiKeyFile // ""' <<<"$instance")" \
  "$(jq -r '.apiKeyCommand // ""' <<<"$instance")")
[[ $resolved == ok:* ]] || fail "${resolved#err:}"
key=${resolved#ok:}

# An id that reaches a path or the bare-integer body has to be numeric first, so
# nothing can turn into a second path segment or a stray JSON token. This runs
# after the config is read, so a caller with no config hears about that first.
if [[ $body == int || $id_in_path == 1 ]]; then
  [[ $target =~ ^[0-9]+$ ]] || {
    tn_warn "a $verb needs a numeric id, got: $target"; usage >&2; exit 2; }
  path=${path//\{id\}/$target}
fi

# The payload file is the only place the name or uuid is written, and jq encodes
# it. The response body is a second mktemp that tn_http_request opens itself;
# both are named to the trap, because fail exits from below and the rm written
# after a call is not reached on the error path. TN_BODY is read with a default
# because the trap is installed before the request has set it and `set -u` is on.
TN_BODY=""
payload=$(mktemp "${TMPDIR:-/tmp}/truenas-api.XXXXXX") \
  || { tn_warn "could not create a temporary file"; exit 1; }
trap 'rm -f "${payload:-}" "${TN_BODY:-}"' EXIT

case $body in
  field) jq -n --arg k "$body_key" --arg v "$target" '{ ($k): $v }' >"$payload" ;;
  int)   jq -n --argjson n "$target" '$n' >"$payload" ;;
  scrub) jq -n --arg name "$target" '{ name: $name, action: "START" }' >"$payload" ;;
  none)  : >"$payload" ;;
esac

if [[ $body == none ]]; then
  tn_http_request POST "$base" "$path" "$key" "$timeout"
else
  tn_http_request POST "$base" "$path" "$key" "$timeout" "$payload"
fi
class=$(tn_classify)

if [[ -z $class ]]; then
  # A service control route answers the JSON boolean `false` on a 2xx when the
  # NAS accepted the request but did not change the service. That is the action
  # not taking effect, so it fails honestly rather than reporting ok. `null`
  # (alert dismiss/restore), `true` (a landed service write) and a job id (an
  # app write) are all accepted, and none of them print the raw body.
  if [[ -s $TN_BODY && $(jq -c . "$TN_BODY" 2>/dev/null) == false ]]; then
    rm -f "$payload" "$TN_BODY"
    unset key resolved
    fail action_failed "the NAS reported the action did not take effect"
  fi
  rm -f "$payload" "$TN_BODY"
  unset key resolved
  printf '{"ok":true}\n'
  exit 0
fi

# tn_error_message reads the NAS's own words (including the top-level `.message`
# a service control route uses) and reads the body file, so it runs before the
# body is removed; a curl-level failure has no body, so name the transport
# instead of printing an empty message.
message=$(tn_error_message)
[[ -n $message ]] || message=$(tn_curl_rc_message "$TN_CURL_RC")
rm -f "$payload" "$TN_BODY"
unset key resolved
fail "$class" "$message"
