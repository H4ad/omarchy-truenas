#!/usr/bin/env bash
# Test stub. Reads the argv shape tn_http_request uses, resolves a canned
# response from STUB_MAP (url<TAB>rc<TAB>http_code<TAB>body_file), and reports it
# the way real curl would. The request URL and the key both arrive in the
# `--config -` document on stdin rather than in argv, so the URL is read back out
# of that document, parsed the way curl parses a quoted value.
#
# STUB_CURL_HEADER_LOG opts one case out, because the header the key is written
# into is the only place a quoting mistake shows: curl processes backslash
# escapes inside a quoted config value, so a key holding a `"` used to be
# truncated there and the request went out with a wrong key and came back 401.
# It is left unset by lib.sh's setup and named by the one case that reads it, so
# no other case can grow a log of its key by accident.
#
# What is logged is the header value curl would send, not the config text it was
# handed: the escaping is what is under test, so a log of the escaped form would
# pass whatever the escaping did. curl's own quoted-value parsing is emulated
# below: a backslash escapes the next character, and the first unescaped `"`
# ends the value, so an unescaped quote a broken writer leaves behind truncates
# the header here instead of being recovered. That divergence from the
# omarchy-signoz copy of this stub (which only strips the outer quotes) is
# deliberate: this log has to be able to fail.
#
# STUB_CURL_ARGV_LOG records every argv word, so a case can prove the URL is not
# among them.
curl_unquote() {
  local v=$1 out="" i=0 n c
  n=${#v}
  while ((i < n)); do
    c=${v:i:1}
    if [[ $c == \\ ]]; then
      ((i++)); ((i < n)) || break
      out+="${v:i:1}"; ((i++))
    elif [[ $c == \" ]]; then
      break
    else
      out+=$c; ((i++))
    fi
  done
  printf '%s\n' "$out"
}

# Prints the value of one `key = value` line from the config document on stdin,
# unquoted when it is quoted.
config_value() {
  local key=$1 line value
  while IFS= read -r line; do
    [[ $line == "$key = "* ]] || continue
    value=${line#"$key = "}
    if [[ $value == \"* ]]; then curl_unquote "${value:1}"
    else printf '%s\n' "$value"
    fi
  done
}

original=("$@")
out=""
url=""
cfg=""
write_fmt=""
while (($#)); do
  case $1 in
    -o) out=$2; shift 2 ;;
    -w) write_fmt=$2; shift 2 ;;
    --config)
      cfg=$(cat)
      shift 2 ;;
    --max-time) shift 2 ;;
    -X) printf '%s ' "$2" >>"${STUB_METHOD_LOG:-/dev/null}"; shift 2 ;;
    -k) printf 'k\n' >>"${STUB_INSECURE_LOG:-/dev/null}"; shift ;;
    -H) shift 2 ;;
    --data-binary) cat "${2#@}" >>"${STUB_PAYLOAD_LOG:-/dev/null}"; shift 2 ;;
    -sS|-fsS) shift ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done

[[ -n $url ]] || url=$(config_value url <<<"$cfg")
[[ -z ${STUB_CURL_HEADER_LOG:-} ]] || config_value header <<<"$cfg" >>"$STUB_CURL_HEADER_LOG"
[[ -z ${STUB_CURL_ARGV_LOG:-} ]] || printf '%s\n' "${original[*]}" >>"$STUB_CURL_ARGV_LOG"

rc=0; code=200; body=/dev/null
if [[ -n ${STUB_MAP:-} && -f $STUB_MAP ]]; then
  while IFS=$'\t' read -r pattern prc pcode pbody; do
    [[ -n $pattern ]] || continue
    if [[ $url == *"$pattern"* ]]; then
      rc=$prc; code=$pcode; body=$pbody
      break
    fi
  done <"$STUB_MAP"
fi

printf '%s ' "$url" >>"${STUB_CURL_LOG:-/dev/null}"
printf '\n' >>"${STUB_CURL_LOG:-/dev/null}"

if [[ -n $out && $body != /dev/null ]]; then
  cat "$body" >"$out"
elif [[ -n $out ]]; then
  : >"$out"
fi

if ((rc == 0)) && [[ -n $write_fmt ]]; then
  printf '%s 0.123' "$code"
fi
exit "$rc"
